# Samsung's vendor init.ramplus.rc unconditionally enables a 2 GiB zram
# swap device when sys.boot_completed is set. Start this asynchronously so it
# runs after that vendor action regardless of init RC parse order.
service t227u_ramplus_off /system/bin/sh /sbin/t227u-ramplus-off.sh
    class core
    user root
    group root
    seclabel u:r:init:s0
    oneshot

on property:sys.boot_completed=1
    start t227u_ramplus_off
