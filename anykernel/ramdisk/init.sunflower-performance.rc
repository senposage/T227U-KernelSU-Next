# Circle to Search: Settings > Navigation bar option + Home/SystemUI path read this at process start
on early-init
    setprop ro.com.google.cdb.spa1 bsxasm1

on late-init
    exec u:r:init:s0 root root -- /system/bin/sh /sbin/sunflower-performance.sh
    exec u:r:init:s0 root root -- /system/bin/sh /sbin/t225-perf-extra.sh
